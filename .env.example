# ===========================================================================
# PhishGuard AI - Environment Configuration Example
# Copy this file to '.env' for local development. Never commit '.env' to git!
# ===========================================================================

# Flask Session & Security Key (Replace with a random 64-character secret in production)
SECRET_KEY=phishguard-production-secret-key-change-me-in-production

# Server Configuration
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=1

# SQLite Database File Path (Default: phishguard.db in project root)
DATABASE_PATH=phishguard.db

# Machine Learning Engine Configuration
# ML models run 100% locally and offline from the models/ directory:
#   - models/email_phishing_detector.joblib
#   - models/url_phishing_detector.joblib
#   - models/model_metadata.json
PHISHGUARD_OFFLINE_INFERENCE=true

# Optional External AI Provider Fallback (Leave blank to use local ML models exclusively)
# Supported providers: openai, anthropic, gemini
PHISHGUARD_AI_PROVIDER=
PHISHGUARD_API_KEY=

# VirusTotal Threat Intelligence API (for live multi-vendor security verification)
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here
